    "description": "欢迎使用Maa_MHXY_MG,新用户请先查阅文档及各个任务的说明（有的任务有说明），请查看齿轮中的选项设置后选择适合自己的，最后免责声明：本项目仅供学习交流使用，请勿用于商业用途，使用本项目即代表您同意免责声明。",
    "mirrorchyan_rid": "Maa_MHXY_MG",
    "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb"
        },
        {
            "name": "PlayCover",
            "label": "PlayCover",
            "type": "PlayCover",
            "description": "部分任务存在兼容问题，不建议使用"
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./../agent/main.py",
            "-u"
        ]
    },
    "resource": [
        {
            "name": "官方混服",
            "path": [
                "./resource/base"
            ],
            "controller": [
                "ADB"
            ]
        },
        {
            "name": "官服",
            "path": [
                "./resource/base",
                "./resource/NeteaseServer"
            ],
            "controller": [
                "ADB"
            ]
        },
        {
            "name": "九游",
            "path": [
                "./resource/base",
                "./resource/9game"
            ],
            "controller": [
                "ADB"
            ]
        },
        {
            "name": "playcover资源",
            "path": [
                "./resource/base",
                "./resource/mac"
            ],
            "controller": [
                "PlayCover"
            ],
            "description": "适用于Mac使用PlayCover的用户"
        }
    ],
